{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackathon-starter",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // The custom domain is created on deploy. The zone must be active in the same Cloudflare account.
  "routes": [{ "pattern": "nebenmir.app", "custom_domain": true }],
  // Keep the workers.dev address alive too: setting routes switches it off unless this is true.
  "workers_dev": true,
  // Spot videos and stills live in an R2 bucket. The app writes to it through this binding (no key needed)
  // and the browser reads from its public domain. See src/app/api/media/route.ts.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nebenmir-media" }],
  "vars": { "MEDIA_PUBLIC_URL": "https://media.nebenmir.app" },
  "observability": { "enabled": true }
}
