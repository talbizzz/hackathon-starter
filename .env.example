# Copy to .env.local (local dev) — never commit real values.
# For Cloudflare, secrets go in .dev.vars (preview) and `wrangler secret` / GitHub secrets (prod). See README.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed for `pnpm db:types` / migrations (project ref = the id in your project URL)
SUPABASE_PROJECT_ID=

# PostHog (Project settings)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# AI (server-side only)
AI_PROVIDER=anthropic            # anthropic | openai | bedrock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Amazon Bedrock (AI_PROVIDER=bedrock): Bedrock API key + any Bedrock model ID
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL=
