{
  // The dev site (hackathon-starter-dev.<account>.workers.dev). Same code, no custom domain.
  // Deploy it with: pnpm deploy:dev
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hackathon-starter-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Spot videos and stills live in an R2 bucket. The app writes to it through this binding (no key needed)
  // and the browser reads from its public domain. See src/app/api/media/route.ts.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "nebenmir-media" }],
  "vars": { "MEDIA_PUBLIC_URL": "https://media.nebenmir.app" },
  "observability": { "enabled": true }
}
